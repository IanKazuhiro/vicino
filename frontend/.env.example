# Copie para .env.local e ajuste. Os arquivos .env* (exceto este) não vão para o Git.

# Base das chamadas à API. Em desenvolvimento, o proxy do Vite repassa /api para http://localhost:8080.
VITE_API_URL=/api

# true: usa os dados fictícios em memória (não precisa do back-end rodando).
# false: chama a API real. Encomendas, avisos e notificações mostram "Disponível em breve".
VITE_USE_MOCKS=true
